{
    "name": "rust-audit-check",
    "version": "2.0.0",
    "private": false,
    "description": "Security audit for security vulnerabilities",
    "main": "lib/main.js",
    "directories": {
        "lib": "lib",
        "test": "__tests__"
    },
    "scripts": {
        "build": "ncc build src/main.ts",
        "watch": "ncc build src/main.ts --watch",
        "test": "jest --passWithNoTests",
        "format": "prettier --write 'src/**/*.{js,ts,tsx}'",
        "refresh": "rm -rf ./dist/* && npm run-script build",
        "lint": "tsc --noEmit && eslint 'src/**/*.{js,ts,tsx}'"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/step-security/audit-check.git"
    },
    "keywords": [
        "actions",
        "rust",
        "cargo",
        "audit",
        "security",
        "advisory"
    ],
    "author": "step-security",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/step-security/audit-check/issues"
    },
    "dependencies": {
        "@actions/core": "^2.0.0",
        "@actions/exec": "^2.0.0",
        "@actions/github": "^8.0.0",
        "@actions/io": "^1.1.3",
        "axios": "^1.18.0",
        "nunjucks": "^3.2.4"
    },
    "devDependencies": {
        "@typescript-eslint/parser": "^6.21.0",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.1.3",
        "@types/jest": "^29.5.12",
        "@types/node": "^24.0.0",
        "@vercel/ncc": "0.38.1",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "typescript": "^5.3.3",
        "prettier": "^3.2.5"
    }
}
